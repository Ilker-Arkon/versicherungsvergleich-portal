#!/bin/sh
# pre-push — letzte Verteidigungslinie vor GitHub.
# Scannt die neu zu pushenden Commits auf .env-Dateien und Secret-Muster.
# Fängt auch ab, was ein `git commit --no-verify` durchgelassen hat.
# Installiert via:  git config core.hooksPath .githooks

. "$(dirname "$0")/guard.sh"

ZERO="0000000000000000000000000000000000000000"

# stdin: je Zeile "<local-ref> <local-sha> <remote-ref> <remote-sha>"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # Neuer Branch: Basis = Merge-Base mit origin/HEAD, sonst alle Commits.
    base=$(git merge-base "$local_sha" origin/HEAD 2>/dev/null)
    if [ -n "$base" ]; then
      commits=$(git rev-list "$base..$local_sha")
    else
      commits=$(git rev-list "$local_sha")
    fi
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for c in $commits; do
    files=$(git diff-tree --no-commit-id --name-only -r "$c")
    if ! block_env_files "$files"; then
      exit 1
    fi

    diff=$(git show --no-color -U0 "$c")
    if ! block_secrets "$diff"; then
      exit 1
    fi
  done
done

exit 0
